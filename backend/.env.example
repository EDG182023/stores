# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Usar la SERVICE ROLE key (secreta, solo en el servidor; nunca en el front)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Telegram (crear el bot con @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:AA...

# Secreto para la URL del webhook (letras, números, _ y -)
WEBHOOK_SECRET=cambia-esto-por-algo-largo

# URL pública del servicio. En Render se toma sola de RENDER_EXTERNAL_URL.
# Si queda vacía (desarrollo local), el bot funciona por polling.
PUBLIC_URL=

# URL del panel web (para los links del bot)
FRONTEND_URL=https://tu-app.vercel.app

# Zona horaria para los resúmenes
TZ_NEGOCIO=America/Argentina/Buenos_Aires

PORT=3000

# --- Asistente IA (gratis) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.5-flash-lite)
AI_MODEL=
# Opcional: Groq (gratis) para transcribir audios con Whisper y como respaldo: https://console.groq.com
GROQ_API_KEY=
# Opcional: OpenRouter con un modelo gratuito (termina en :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
